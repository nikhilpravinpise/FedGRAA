# Datasets (large CSVs — never commit)
data/
*.csv

# Preprocessed data cache (built locally by each collaborator)
.cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Editor / OS
.vscode/
.idea/
*.DS_Store
Thumbs.db

# Kaggle credentials (never commit)
kaggle.json

# Experiment outputs: results/*.json and results/figures/*.png ARE committed
# (they are the persisted, verifiable reproduction artifacts — see
# docs/GPU_DECISION_AND_NEXT_STEPS.md P1 and docs/fedgraa_divergence_diagnosis.md).
# Only checkpoints and .npy caches are excluded as large/regeneratable.
.checkpoint/
*.npy
# Campaign driver logs -- verbose per-round training output, regeneratable
# by re-running the driver; the persisted JSON results are what matter.
results/ablation/_logs/
